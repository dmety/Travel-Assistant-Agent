# Java / Maven 构建产物
**/target/
*.class

# Python 缓存与本地虚拟环境
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/

# 本地依赖与工具链
node_modules/
/.tools/
/.workbuddy/

# IDE 与系统本地文件
.idea/
.vscode/
*.iml
.DS_Store
Thumbs.db
Desktop.ini

# 密钥与本地环境；示例不得含真实密钥
.env
.env.*
!.env.example
!.env.sample

# 日志、临时文件与本地输出
*.log
*.tmp
*.temp
*.swp
*.swo
~$*
/.tmp/
/tmp/
/temp/
/outputs/
/previews/
/screenshots/

# 运行态数据不提交；保留全国知识库与按省分片编辑源
# attractions/ 是按省切分的小文件，是知识库的唯一编辑源，必须入库
# china_attractions.json 与 attractions_index.json 是产物，保留以便新克隆开箱即用
# 各 Store 在文件缺失时自动创建空文件，仓库不再预置 *.example.json 空数组
/data/*
!/data/china_attractions.json
!/data/attractions_index.json
!/data/attractions/
!/data/attractions/*.json
# 预留给未来的脱敏配置种子（如 agent_providers.example.json），当前无此类文件
!/data/*.example.json
/travel-server/data/

# 不整体忽略 reports/，保留必要来源证据和用户要求的清单。
# 不全局忽略 JSON、CSV、PDF、图片或压缩包，以免隐藏必要交付物。
# 忽略规则不会取消已跟踪文件，也不会自动清理文件。

# 购票辅助运行配置与字段级来源（不含用户数据）
!/data/ticket_channels.json
!/data/ticket_rules.json

# 设计稿仅本地保留，不入库（原型页、令牌源、Axure 素材与导出图）
# 页面与移动端已各自内联令牌与图标，运行时不依赖本目录
# 注意：tools/design_icons.py 以本目录为源，克隆后需自备设计稿才能执行
/design/

# Docker 相关仅本地保留，不入库/不推送（用户要求：不 push 到 GitHub）
Dockerfile
Dockerfile.*
.dockerignore
docker-compose*.yml
docker-compose*.yaml
compose*.yml
compose*.yaml
