<?xml version="1.0" ?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.travelassistant</groupId>
    <artifactId>travel-assistant</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>
  <artifactId>travel-client</artifactId>
  <properties>
    <!-- 3.30.x 与 Spring Shell 3.4.x 所用 JLine 同线；4.x 为大版本且刚发布，暂不升级。 -->
    <jline.version>3.30.17</jline.version>
  </properties>
  <dependencies>
    <dependency>
      <groupId>com.travelassistant</groupId>
      <artifactId>travel-common</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
    <!-- JLine 3：终端能力探测、行编辑/历史/补全、ANSI 着色。
         只引最小模块，避免聚合包把 sshd/jansi 一并打进可执行 jar。 -->
    <dependency>
      <groupId>org.jline</groupId>
      <artifactId>jline-terminal</artifactId>
      <version>${jline.version}</version>
    </dependency>
    <dependency>
      <groupId>org.jline</groupId>
      <artifactId>jline-reader</artifactId>
      <version>${jline.version}</version>
    </dependency>
    <!-- Windows 下通过 JNI 启用虚拟终端处理，否则传统 conhost 会被判为 dumb 而丢失颜色。 -->
    <dependency>
      <groupId>org.jline</groupId>
      <artifactId>jline-terminal-jni</artifactId>
      <version>${jline.version}</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.6.1</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <transformers combine.self="override">
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>com.travelassistant.client.TravelClient</mainClass>
                </transformer>
                <!-- JLine 靠 ServiceLoader 发现 TerminalProvider；uber jar 必须合并 services，
                     否则 Windows 原生终端探测失效并退化成无颜色输出。 -->
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>

