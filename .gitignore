# Java / Maven 构建产物
**/target/
*.class

# Python 缓存与本地虚拟环境
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/

# 本地依赖与工具链
node_modules/
/.tools/
/.workbuddy/

# IDE 与系统本地文件
.idea/
.vscode/
*.iml
.DS_Store
Thumbs.db
Desktop.ini

# 密钥与本地环境；示例不得含真实密钥
.env
.env.*
!.env.example
!.env.sample

# 日志、临时文件与本地输出
*.log
*.tmp
*.temp
*.swp
*.swo
~$*
/.tmp/
/tmp/
/temp/
/outputs/
/previews/
/screenshots/

# 运行态数据不提交；保留全国知识库与初始化种子
# attractions/ 是按省切分的小文件，是知识库的唯一编辑源，必须入库
# kb_modules/ 是按职责分层的派生视图，由 --sync 自动重建，不手工编辑
/data/*
!/data/china_attractions.json
!/data/attractions_index.json
!/data/attractions/
!/data/attractions/*.json
!/data/kb_modules/
!/data/kb_modules/*.json
!/data/*.example.json
/travel-server/data/

# 不整体忽略 reports/，保留必要来源证据和用户要求的清单。
# 不全局忽略 JSON、CSV、PDF、图片或压缩包，以免隐藏必要交付物。
# 忽略规则不会取消已跟踪文件，也不会自动清理文件。

# 购票辅助运行配置与字段级来源（不含用户数据）
!/data/ticket_channels.json
!/data/ticket_rules.json
