# Required for natural-language model replies.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# Used only when a CLI chat includes an image; defaults to DeepSeek's vision-capable Flash model.
DEEPSEEK_VISION_MODEL=deepseek-flash
BAIDU_BROWSER_AK=
# PDF export: a local Chinese TrueType font; Windows defaults to simhei.ttf.
TRAVEL_PDF_FONT=C:/Windows/Fonts/simhei.ttf

# Optional map services. AMAP_API_KEY is mapped to AMAP_KEY by the launcher.
AMAP_API_KEY=
BAIDU_AK=
# Agent Plan SK; separate from BAIDU_AK. Keep this value private.
BAIDU_MAP_AUTH_TOKEN=
# Jumdata scenic-spot API AppCode. Configure on the server only; never commit a real value.
JUMDATA_SCENIC_APPCODE=
JUMDATA_SCENIC_BASE_URL=https://jmqgjdcx.market.alicloudapi.com
JUMDATA_SCENIC_TIMEOUT_MS=8000

# Local server settings. Payment remains in sandbox mode.
SERVER_PORT=8080
TRAVEL_PAYMENT_MODE=sandbox
TRAVEL_DATA_DIR=./data
