<?xml version="1.0" encoding="utf-8"?>
<!--
  仅调试构建生效（src/debug 覆盖 src/main）。
  局域网真机联调要连 http://192.168.x.x:8080 这类明文地址，这里放开明文；
  release 构建用 src/main 那份，只放行回环与模拟器宿主别名，其余强制 HTTPS。
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
